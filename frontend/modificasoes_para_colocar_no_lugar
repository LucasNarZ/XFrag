* {
  margin: 0; /* Remove margens padrão de todos os elementos */
  padding: 0; /* Remove espaçamento interno padrão */
  box-sizing: border-box; /* Inclui borda e padding no cálculo de largura/altura */
}

html, body {
  margin: 0; /* Remove margens do HTML e body */
  padding: 0; /* Remove espaçamento interno */
  height: 100%; /* Define altura total da tela */
  width: 100%; /* Define largura total da tela */
}

/* faixa azul */
.faixa {
  background: #121369; /* Cor de fundo azul escuro */
  color: white; /* Texto branco */
  text-align: center; /* Centraliza texto horizontalmente */
  width: 100%; /* Ocupa toda a largura */
  height: 80px; /* Altura da faixa */
  line-height: 80px; /* Centraliza texto verticalmente */
  font-size: 24px; /* Tamanho da fonte */
  border-bottom-left-radius: 20px; /* Arredonda canto inferior esquerdo */
  border-bottom-right-radius: 20px; /* Arredonda canto inferior direito */
}

.retangulo {
  width: 700px; /* Largura do quadro */
  height: 160px; /* Altura do quadro */
  background-color: white; /* Fundo branco */
  border: 3px solid gray; /* Borda cinza */
  border-radius: 10px; /* Cantos arredondados */
  position: relative; /* Permite posicionamento com top/left */
  left: 825px; /* Move para a direita */
  top: 20px; /* Move para baixo */
  margin-bottom: 10px; /* Espaço abaixo */
}

.retangulo-diferente {
  width: 700px;
  height: 100px;
  background-color: white;
  border: 3px solid gray;
  border-radius: 10px;
  margin-bottom: 50px;
  position: relative;
  left: 825px;
  top: 40px;
}

.retangulo-identificao {
  width: 500px;
  height: 300px;
