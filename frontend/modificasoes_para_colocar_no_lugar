<!DOCTYPE html> <!-- Define o tipo de documento como HTML5 -->
<html lang="pt-BR"> <!-- Início do documento, idioma definido como português do Brasil -->
<head>
  <meta charset="UTF-8"> <!-- Define a codificação de caracteres como UTF-8 -->
  <title>Faixa com CSS separado</title> <!-- Título da página exibido na aba do navegador -->
  <!-- link para o arquivo CSS externo -->
  <link rel="stylesheet" href="pagina_de_teste.css"> <!-- Importa o arquivo CSS -->
</head>
<body> <!-- Início do corpo da página -->

  <!-- faixa azul -->
  <div class="faixa"></div> <!-- Div que representa a faixa azul no topo -->

  <!-- quadros iguais -->
  <div class="retangulo"></div> <!-- Primeiro quadro branco -->
  <div class="retangulo"></div> <!-- Segundo quadro branco -->
  <div class="retangulo"></div> <!-- Terceiro quadro branco -->

  <!-- quadro diferente -->
  <div class="retangulo-diferente"></div> <!-- Quadro menor, diferente dos anteriores -->

  <!-- quadro identificação -->
  <div class="retangulo-identificao"></div> <!-- Quadro azul para identificação -->

  <!-- quadro do gráfico -->
  <div class="retangulo-grafico"></div> <!-- Quadro branco para o gráfico -->

  <!-- botão de menu com ícone -->
  <button class="botao-menu"> <!-- Botão de menu -->
    <img src="icones/menu.png" class="botao-menu"> <!-- Ícone dentro do botão -->
  </button>

  <!-- botão de pessoa com ícone -->
  <button class="botao-pessoa"> <!-- Botão de pessoa -->
    <img src="icones/pesssoa.png" class="botao-pessoa"> <!-- Ícone dentro do botão -->
  </button>

  <!-- botão de sino com ícone -->
  <button class="botao-sino"> <!-- Botão de sino -->
    <img src="icones/sino.png" class="botao-sino"> <!-- Ícone dentro do botão -->
  </button>

  <!-- botão de casa com ícone e texto -->
  <button class="botao-casa"> <!-- Botão de casa -->
    <img src="icones/casa.png" alt="Casa" class="icone"> <!-- Ícone da casa -->
    <span class="texto-botao">INICIO |</span> <!-- Texto ao lado do ícone -->
  </button>

  <!-- botão de calculadora com ícone e texto -->
  <button class="botao-calculadora"> <!-- Botão de calculadora -->
    <img src="icones/calculadora.png" alt="Calculadora" class="icone"> <!-- Ícone da calculadora -->
    <span class="texto-botao">Calcular Score</span> <!-- Texto ao lado do ícone -->
  </button>

  <!-- botão de Limpar Seleção com ícone e texto -->
  <button class="botao-voltar"> <!-- Botão de limpar seleção -->
    <img src="icones/voltar.png" alt="Voltar" class="icone"> <!-- Ícone de voltar -->
    <span class="texto-botao">Limpar Seleção</span> <!-- Texto ao lado do ícone -->
  </button>

</body> <!-- Fim do corpo da página -->
</html> <!-- Fim do documento HTML -->




